# Copy to .env and fill in. Never commit .env.

# Where this server is reachable from your AI client, without /mcp.
PUBLIC_URL=https://mcp.example.com

# Auth: set one or both.
# OWNER_PASSWORD turns on OAuth (needed for claude.ai / Claude Desktop connectors).
# API_TOKEN allows a static "Authorization: Bearer <token>" header (Claude Code, Codex, Gemini CLI, Cursor).
# Generate long random values, e.g.: openssl rand -base64 32
OWNER_PASSWORD=
API_TOKEN=

# Foundry, as seen from this server (in docker-compose, the container name).
FOUNDRY_URL=http://foundry:30000
# Foundry's own public URL. Foundry v14 rejects logins without its origin.
FOUNDRY_ORIGIN=https://foundry.example.com
# A Foundry user in your world that the server logs in as (Gamemaster role for full access).
FOUNDRY_USER=Claude
FOUNDRY_PASSWORD=
